{
  "name": "attractor",
  "version": "0.1.0",
  "description": "A DOT-based pipeline orchestration system for AI workflows - TypeScript implementation of StrongDM's Attractor",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "attractor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": ["ai", "pipeline", "orchestration", "dot", "graphviz", "llm", "agent"],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "@types/node": "^22.0.0"
  }
}
